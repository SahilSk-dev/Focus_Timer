# ============================================================
# FOCUS STUDY TIMER - WEB ENVIRONMENT CONFIGURATION (TEMPLATE)
# Duplicate this file as .env and fill in your values
# ============================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000

# SQLite Database Location
DATABASE_PATH=./focus.db

# SMTP / Email Configuration (For Email OTP & Magic Link Login)
# For Gmail, generate an App Password from your Google Account settings:
# https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Firebase Web App Configuration (Client-side sync & Firestore)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
